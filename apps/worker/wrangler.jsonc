{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "invest-vitals",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "invest-vitals-db",
      "migrations_dir": "migrations",
      "database_id": "8c41748f-1604-48da-b7c2-8d0301514c7d"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "172c21756f794e2cb8483e9a8cab441d"
    }
  ],
  "triggers": {
    "crons": ["15 12 * * 1-5"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true
}
